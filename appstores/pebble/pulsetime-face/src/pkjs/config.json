[
  {
    "type": "heading",
    "defaultValue": "PulseTime Face"
  },
  {
    "type": "text",
    "defaultValue": "The haptic clock as your watchface. Double-tap the watch and feel the time \u2014 nothing to launch, nothing to exit, no background worker holding the watch's only worker slot. This is the only way to feel the time without any app starting at all. The price is that it has to be your watchface, and that it only works while it is the one on screen: open any app, or even the launcher, and it stops until you come back. If you mainly want chimes, the PulseTime app does those better \u2014 it schedules them with the watch, so they arrive whatever face you are using. A watchface has no buttons either \u2014 Up and Down belong to the timeline and Select opens the launcher \u2014 so everything is set from this page."
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Haptic language"
      },
      {
        "type": "select",
        "messageKey": "SYSTEM",
        "label": "Time system",
        "defaultValue": "terse_quarter",
        "options": [
          {
            "label": "Terse Quarter (hours, quarters)",
            "value": "terse_quarter"
          },
          {
            "label": "Five-Minute Ladder",
            "value": "five_minute_ladder"
          },
          {
            "label": "Decimal Place Rhythm",
            "value": "decimal_place"
          },
          {
            "label": "Binary Clock",
            "value": "binary_clock"
          },
          {
            "label": "Nearest-Quarter Offset",
            "value": "nearest_quarter"
          },
          {
            "label": "Morse Digits",
            "value": "morse_digits"
          }
        ],
        "description": "The same six systems as the PulseTime app, from the same encoder. If you already know one, it reads identically here."
      },
      {
        "type": "select",
        "messageKey": "SPEED",
        "label": "Playback speed",
        "defaultValue": "standard",
        "options": [
          {
            "label": "Slow",
            "value": "slow"
          },
          {
            "label": "Standard",
            "value": "standard"
          },
          {
            "label": "Fast",
            "value": "fast"
          }
        ],
        "description": "Slow stretches every pulse and pause by 25%; Fast shortens them by 22%."
      },
      {
        "type": "toggle",
        "messageKey": "EXACT_MINUTES",
        "label": "Exact minutes (Terse Quarter only)",
        "defaultValue": false,
        "description": "Adds short ticks for the leftover minutes inside the quarter. The other five systems are already exact to the minute."
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Double-tap to feel the time"
      },
      {
        "type": "toggle",
        "messageKey": "TAP_TELL",
        "label": "Double-tap to tell time",
        "defaultValue": true,
        "description": "Tap the watch twice, in the same direction, within about a second. This is why the face exists, so it is on by default — but it does cost battery, because the watch has to keep its accelerometer listening all day. A single tap is deliberately ignored: one tap fires constantly during ordinary arm movement. The face also stays deaf while it is buzzing, since the motor shakes the watch hard enough to look like your gesture."
      }
    ]
  },
